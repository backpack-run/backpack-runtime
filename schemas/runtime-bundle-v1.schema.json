{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://backpack.run/schemas/runtime-bundle-v1.schema.json",
  "title": "Installed Backpack runtime bundle",
  "type": "object",
  "required": ["schema_version", "engine", "version", "variant", "os", "architecture", "backend", "executable", "files", "source", "license"],
  "properties": {
    "schema_version": {"const": 1},
    "engine": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "variant": {"type": "string", "minLength": 1},
    "os": {"enum": ["windows", "linux", "darwin"]},
    "architecture": {"enum": ["amd64", "arm64"]},
    "backend": {"type": "string", "minLength": 1},
    "executable": {"type": "string", "minLength": 1},
    "files": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "source": {"type": "object"},
    "license": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
